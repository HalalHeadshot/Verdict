GROQ_API_KEY=your_groq_api_key_here
# Used for RAG grounding — verification claims are checked against live web
# search results before being fact-checked. If unset, the pipeline falls back
# to the model's unaided training knowledge for every claim.
TAVILY_API_KEY=your_tavily_api_key_here
# Used to share the claim cache, evidence cache, auth tokens, and rate limit
# state across backend instances via Redis. If unset, each falls back to
# in-memory storage local to that one process (fine for a single instance,
# e.g. local dev without Docker). When running via docker-compose, this gets
# overridden to redis://redis:6379 (the container's network address) —
# use redis://localhost:6379 here if running Redis via Docker but the API
# locally with `pnpm dev`.
REDIS_URL=redis://localhost:6379
PORT=3001
NODE_ENV=development
# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
# Set to "true" to bypass Groq and return mocked responses (for UI testing)
MOCK_MODE=false
